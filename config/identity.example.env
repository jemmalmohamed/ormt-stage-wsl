# Identités propres au Stage. Copier vers config/identity.stage.local.env.
# Jeu fictif prêt au test : installer/windows/generate-stage-identities.ps1.
# Console de test Stage : admin/admin, sans changement obligatoire.
# Remplacer toutes les valeurs CHANGE_ME ; ne jamais versionner le fichier local.
# 1. Compte jetable d'amorçage et client technique permanent
KC_BOOTSTRAP_ADMIN_USERNAME=ormt-bootstrap
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD
ORMT_KEYCLOAK_SERVICE_CLIENT_SECRET=CHANGE_ME_32_RANDOM_CHARACTERS_MINIMUM

# 2. Titulaire du rôle ORMT master (nom d'utilisateur libre)
ORMT_BOOTSTRAP_MASTER_USERNAME=o.master
ORMT_BOOTSTRAP_MASTER_EMAIL=o.master@ormt.test
ORMT_BOOTSTRAP_MASTER_FIRST_NAME=Master
ORMT_BOOTSTRAP_MASTER_LAST_NAME=Stage
ORMT_BOOTSTRAP_MASTER_INITIAL_PASSWORD=ormt
ORMT_BOOTSTRAP_MASTER_TEMPORARY_PASSWORD=true

# 3. Titulaire du rôle ORMT admin (nom d'utilisateur libre)
ORMT_BOOTSTRAP_ADMIN_USERNAME=o.admin
ORMT_BOOTSTRAP_ADMIN_EMAIL=o.admin@ormt.test
ORMT_BOOTSTRAP_ADMIN_FIRST_NAME=Admin
ORMT_BOOTSTRAP_ADMIN_LAST_NAME=Stage
ORMT_BOOTSTRAP_ADMIN_INITIAL_PASSWORD=ormt
ORMT_BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=true

# 4. Administrateur humain de la console Keycloak, distinct des comptes ORMT
ORMT_KEYCLOAK_CONSOLE_ADMIN_USERNAME=admin
ORMT_KEYCLOAK_CONSOLE_ADMIN_EMAIL=admin@ormt.test
ORMT_KEYCLOAK_CONSOLE_ADMIN_FIRST_NAME=Admin
ORMT_KEYCLOAK_CONSOLE_ADMIN_LAST_NAME=Stage
ORMT_KEYCLOAK_CONSOLE_ADMIN_INITIAL_PASSWORD=admin
ORMT_KEYCLOAK_CONSOLE_ADMIN_TEMPORARY_PASSWORD=false

# 5. SMTP ORMT : relais de capture local accessible depuis Core ET Keycloak.
# Aucun courrier réel ; aucun secret SMTP de la plateforme ou de production.
SMTP_HOST=ormt-mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAILING_FROM_EMAIL=noreply@ormt.test
KEYCLOAK_SMTP_FROM=noreply@ormt.test
